        },
        "matlab": {
            "patterns": [
                "{search_text}_SubjectTrialLog.mat",
                "{search_text}_SubjectTimeLog.mat"
            ],
            "subfolder_pattern": "{search_text[:6]}"
        }
    },
    "output_naming": {
        "eprime": "{search_text}_NIR_NBK_COG{ext}",
        "eeg": [
            "{search_text}_EEG_NBK_DAT.edf",
            "{search_text}_EEG_NBK_MRK.csv"
        ],
        "matlab": [
            "{search_text}_SubjectTrialLog.mat",
            "{search_text}_SubjectTimeLog.mat"
        ]
    },
    "destination_base": "C:\\Projects\\{subject_prefix}"
}